# Supabase público (browser). Prefira a publishable key nos ambientes novos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade temporária com ambientes que ainda usam a chave anon legada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Exclusiva do servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública canônica usada por callbacks e pelo Media Delivery Gateway /d/{token}.
# Deve corresponder ao ambiente em execução: preview -> URL estável do preview/branch;
# produção -> domínio de produção. Não misture domínios no mesmo fluxo OAuth.
# Ex.: https://app.seudominio.com
APP_PUBLIC_URL=

# Instagram Business Login direto (Instagram API with Instagram Login).
# O callback canônico é APP_PUBLIC_URL + /api/oauth/instagram/callback.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Escopos mínimos para conectar uma conta profissional e publicar conteúdo.
INSTAGRAM_OAUTH_SCOPES=instagram_business_basic,instagram_business_content_publish
# Overrides opcionais; os endpoints oficiais atuais já são os defaults no código.
INSTAGRAM_OAUTH_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com

# Meta/Facebook Login para Páginas do Facebook e recursos avançados do Instagram.
# O callback canônico é APP_PUBLIC_URL + /api/oauth/meta/callback.
# Use o App ID e App Secret do aplicativo Meta/Facebook configurado para Facebook Login.
# Não reutilize automaticamente as credenciais do Instagram Login direto.
META_CLIENT_ID=
META_CLIENT_SECRET=
# Os endpoints oficiais v26.0 já são defaults. Preencha somente para override.
META_OAUTH_AUTHORIZE_URL=https://www.facebook.com/v26.0/dialog/oauth
META_OAUTH_TOKEN_URL=https://graph.facebook.com/v26.0/oauth/access_token
META_GRAPH_BASE_URL=https://graph.facebook.com/v26.0
# Escopos essenciais são escolhidos pelo backend conforme a finalidade
# (Facebook Pages ou Instagram avançado). Use esta variável só para extras.
META_OAUTH_SCOPES=
# 32 bytes em base64 para criptografia AES-GCM dos tokens antes de persistir.
OAUTH_TOKEN_ENCRYPTION_KEY=

# Object storage / Cloudflare R2.
# O navegador deve enviar arquivos grandes por URL assinada/multipart, sem passar o arquivo inteiro pelo servidor da aplicação.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Reservado para usos futuros com host público/custom domain. A entrega privada atual usa URLs S3 assinadas.
OBJECT_STORAGE_PUBLIC_HOST=
OBJECT_STORAGE_REGION=auto

# Worker periódico / operações internas.
# WORKER_SECRET protege chamadas internas manuais/servidor-servidor.
WORKER_SECRET=
# CRON_SECRET é usado pela Vercel para autenticar o executor periódico quando o cron for habilitado em produção.
CRON_SECRET=
