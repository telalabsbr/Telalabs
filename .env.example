# Supabase público (browser). Prefira a publishable key nos ambientes novos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade temporária com ambientes que ainda usam a chave anon legada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Exclusiva do servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OAuth Meta (Instagram + Facebook Pages).
# URLs e scopes ficam configuráveis para não acoplar o app a versões antigas da API.
META_CLIENT_ID=
META_CLIENT_SECRET=
META_OAUTH_AUTHORIZE_URL=
META_OAUTH_TOKEN_URL=
META_GRAPH_BASE_URL=
META_OAUTH_SCOPES=
# 32 bytes em base64 para criptografia AES-GCM dos tokens antes de persistir.
OAUTH_TOKEN_ENCRYPTION_KEY=

# Object storage / Cloudflare R2.
# O navegador deve enviar arquivos grandes por URL assinada/multipart, sem passar o arquivo inteiro pelo servidor da aplicação.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_HOST=
OBJECT_STORAGE_REGION=auto

# Worker de publicação. Mantém-se desligado até existir provider adapter real testado.
PUBLISHING_WORKER_ENABLED=false
WORKER_SECRET=
